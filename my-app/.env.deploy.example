# Copy this file to `.env.deploy` and fill in your values.
# `.env.deploy` is gitignored so your infra details stay out of the repo.

# Required: the S3 bucket that serves the site.
S3_BUCKET=your-bucket-name

# Required: the CloudFront distribution that fronts the bucket.
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# Optional: named AWS CLI profile to use (omit to use the default credentials).
# AWS_PROFILE=personal

# Optional: bucket region (defaults to us-east-1).
# AWS_REGION=us-east-1
